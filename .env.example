# Night Desk — paper mode needs none of the secrets below.
# Copy to .env only if you want overrides. Never commit .env.

# --- Server ---
PORT=4721
HOST=0.0.0.0
# Optional shared secret for a phone tunnel. When set, every page, /api/*, and /ws
# requires header X-Desk-Token or query ?token=. Leave empty at home on localhost.
# Never commit a real value.
DESK_TOKEN=

# --- Mode ---
# Live trading is OFF unless this is exactly the string true.
# Anything else (unset, false, TRUE, 1) stays on the paper ledger.
LIVE_TRADING=false
# Required for live, ignored for paper. Path to a Solana CLI JSON keypair. Never commit the file.
WALLET_KEYPAIR_PATH=
# v13.5: the desk wallet's private key (Phantom export = base58, or a JSON byte array).
# Paste it ONLY into Austin's .env. Never into the phone, a chat, or git. Read in memory only.
WALLET_PRIVATE_KEY=
# Optional wipe of the open paper book on boot. Does not delete the log, advisor memory, or volume floor.
# The in-app Reset book button always returns cash to $100 and ignores this override.
PAPER_RESET=0
# Used only when no book is saved yet, or when PAPER_RESET=1 on boot. Default in code is 100.
PAPER_BALANCE_USD=100

# --- Feeds ---
# auto: replay demo + live public feeds
# replay: demo tape only
# live: public feeds only (UI can sit quiet if upstream is down)
FEED_MODE=auto
# Set to 0 to disable the seeded replay tape.
# Phone / overnight on real prints, still paper: DEMO_FEED=0 and FEED_MODE=live.
DEMO_FEED=1

# Public Solana RPC. Helius-style: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional RPC websocket. When empty, the desk derives it from SOLANA_RPC_URL.
# Helius: wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_WS_URL=
# Optional PumpPortal key. Appended to the existing Scout socket only.
# Pump core does not open a second PumpPortal socket and does not call trade-local.
PUMPPORTAL_API_KEY=
# On a Helius URL, pages of 1,000 holder accounts past the 20-account RPC cap. 0 disables it.
HOLDER_PAGES_MAX=3
# Pump.fun new-token websocket (PumpPortal public stream).
PUMP_WS_URL=wss://pumpportal.fun/api/data
# Optional Bitquery bearer token. When set, Scout also polls Bitquery for new Solana DEX trades.
BITQUERY_API_KEY=
# RugCheck public report API used as a supplemental LP / rug hint. Failures fall back to on-chain reads.
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1
# Enrich workers in flight. Default 8. Clamped to 1–16 so a public RPC is not stampeded.
# Does not change filter rules.
SCOUT_ENRICH_CONCURRENCY=8
# Pending sightings before the oldest unseen mint is dropped. Default 160. Clamped 8–2000.
SCOUT_ENRICH_QUEUE=160
# Optional JSON file of extra known rug deployers: { "wallets": { "<address>": "why" } }
RUG_WALLETS_FILE=

# --- Persistence ---
DB_PATH=./data/desk.sqlite
LOG_JSONL=./data/desk.jsonl
# Plain-text mirror of every scout/filter/analyst/executor/risk/system line.
LOG_FILE=./data/desk.log
# Learned advisory memory (win rates by volume / holders / liquidity). Advice only.
ADVISOR_PATH=./data/advisor.json
# Optional commentary. Notes only. The desk never sends this key an order, and it never places a trade.
# With the key unset, the same panel uses rule-based notes from pipeline stats.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Jupiter (live swaps only; never called in paper mode) ---
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap

# --- Risk clamps ---
# You may tighten these. Looser values are ignored and the hard floor/cap is kept.
# MAX_POSITION_PCT cannot exceed 0.08
# STOP_LOSS_PCT cannot exceed 0.06
# TRAIL_ARM_PCT cannot be below 0.12
# TRAIL_GAP_PCT cannot exceed 0.04
# ANALYST_MIN_SCORE cannot be below 0.6
# MIN_VOLUME_1H_USD is the boot default for the 1h volume floor (clamped $1,000–$500,000).
# The terminal can change it later. That choice is stored in the desk database and wins on the next boot.
# MAX_TOP10_PCT cannot exceed 0.20
# REVENGE_COOLDOWN_MS cannot be below 21600000 (6h)
# Liquidity is an analyst score only. There is no executor liquidity floor.
MAX_POSITION_PCT=0.08
STOP_LOSS_PCT=0.06
TRAIL_ARM_PCT=0.12
TRAIL_GAP_PCT=0.04
ANALYST_MIN_SCORE=0.6
MIN_VOLUME_1H_USD=50000
MAX_TOP10_PCT=0.20
REVENGE_COOLDOWN_MS=21600000
